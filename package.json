{
  "name": "chore-quest",
  "version": "1.2.0",
  "description": "Premium Kid's Chore Tracker for Raspberry Pi",
  "main": "server.js",
  "scripts": {
    "setup": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "dev": "node server.js & cd client && npm run dev",
    "lint": "eslint . --ignore-pattern client",
    "format": "prettier --write ."
  },
  "keywords": [
    "chores",
    "kids",
    "raspberry-pi",
    "express",
    "react",
    "sqlite"
  ],
  "author": "Antigravity",
  "license": "GPL-3.0-only",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "eslint": "^8.57.0",
    "globals": "^15.3.0",
    "prettier": "^3.2.5"
  }
}
